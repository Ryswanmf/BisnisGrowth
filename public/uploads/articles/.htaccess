# Disable execution of scripts in this directory
Options -ExecCGI
AddHandler cgi-script .php .php3 .php4 .phtml .pl .py .jsp .asp .htm .html .sh .cgi
<FilesMatch "\.(php|php3|php4|phtml|pl|py|jsp|asp|htm|html|sh|cgi)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Limit file size to 5MB (optional but good)
LimitRequestBody 5242880
